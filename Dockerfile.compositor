FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install video processing libraries
RUN pip3 install --no-cache-dir \
    numpy>=1.25.0 \
    moviepy \
    srt \
    openai-whisper \
    fastapi \
    uvicorn

COPY compose_video.py .

CMD ["python3", "compose_video.py"]
