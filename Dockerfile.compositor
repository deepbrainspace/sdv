FROM jrottenberg/ffmpeg:5.1-ubuntu2004

WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install video processing libraries
RUN pip3 install \
    moviepy \
    srt \
    whisper \
    fastapi \
    uvicorn

COPY compose_video.py .

CMD ["python3", "compose_video.py"]
