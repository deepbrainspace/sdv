{
    "name": "Basic Character Animation",
    "description": "Simple character animation with AnimateDiff",
    "metadata": {
        "version": "1.0",
        "required_models": ["sd_3.5_base", "mm_sd_v15_v2"],
        "recommended_vram": "12GB",
        "tags": ["character", "animation", "animatediff"]
    },
    "default_prompt": {
        "positive": "masterpiece, best quality, 1girl, white hair, blue eyes, standing, smiling",
        "negative": "bad hands, bad face, bad quality, blurry"
    },
    "nodes": {
        "3": {
            "class_type": "KSampler",
            "inputs": {
                "cfg": 7,
                "denoise": 1,
                "latent_image": ["5", 0],
                "model": ["4", 0],
                "negative": ["7", 0],
                "positive": ["6", 0],
                "seed": 8566257,
                "steps": 20
            }
        },
        "4": {
            "class_type": "CheckpointLoaderSimple",
            "inputs": {
                "ckpt_name": "sd_3.5_base.safetensors"
            }
        },
        "5": {
            "class_type": "EmptyLatentImage",
            "inputs": {
                "batch_size": 16,
                "height": 512,
                "width": 512
            }
        },
        "6": {
            "class_type": "CLIPTextEncode",
            "inputs": {
                "clip": ["4", 1],
                "text": "masterpiece, best quality, 1girl, white hair, blue eyes, standing, smiling"
            }
        },
        "7": {
            "class_type": "CLIPTextEncode",
            "inputs": {
                "clip": ["4", 1],
                "text": "bad hands, bad face, bad quality, blurry"
            }
        },
        "8": {
            "class_type": "AnimateDiffCombine",
            "inputs": {
                "frames": ["3", 0],
                "motion_model": "mm_sd_v15_v2.ckpt",
                "motion_scale": 1
            }
        },
        "9": {
            "class_type": "VAEDecode",
            "inputs": {
                "samples": ["8", 0],
                "vae": ["4", 2]
            }
        },
        "10": {
            "class_type": "SaveVideo",
            "inputs": {
                "frame_rate": 8,
                "images": ["9", 0],
                "video_format": "mp4",
                "filename_prefix": "character_animation"
            }
        }
    }
} 