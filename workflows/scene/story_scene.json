{
    "name": "Narrative Scene Generation",
    "description": "Generate story-driven scenes with camera movement and transitions",
    "metadata": {
        "version": "1.0",
        "required_models": [
            "sd_3.5_large",
            "control_v11p_sd15_depth",
            "svd_xt"
        ],
        "recommended_vram": "24GB",
        "tags": ["scene", "story", "camera", "transition"]
    },
    "default_prompt": {
        "scene_description": "magical forest path, sunbeams through trees, mystical atmosphere",
        "camera_movement": "slow dolly forward, slight pan right",
        "style": "cinematic, dramatic lighting, golden hour"
    },
    "nodes": {
        "1": {
            "class_type": "CheckpointLoaderSimple",
            "inputs": {
                "ckpt_name": "sd_3.5_large.safetensors"
            }
        },
        "2": {
            "class_type": "SVDLoader",
            "inputs": {
                "model_name": "svd_xt.safetensors"
            }
        },
        "3": {
            "class_type": "CLIPTextEncode",
            "inputs": {
                "clip": ["1", 1],
                "text": "magical forest path, sunbeams through trees, mystical atmosphere, cinematic, dramatic lighting, golden hour, masterpiece, best quality"
            }
        },
        "4": {
            "class_type": "EmptyLatentImage",
            "inputs": {
                "batch_size": 16,
                "height": 768,
                "width": 1024
            }
        },
        "5": {
            "class_type": "KSamplerAdvanced",
            "inputs": {
                "cfg": 8,
                "denoise": 1,
                "latent_image": ["4", 0],
                "model": ["1", 0],
                "negative": ["6", 0],
                "positive": ["3", 0],
                "scheduler": "karras",
                "seed": 8566257,
                "steps": 30
            }
        },
        "6": {
            "class_type": "CLIPTextEncode",
            "inputs": {
                "clip": ["1", 1],
                "text": "bad quality, blurry, noise, shaky camera, poor lighting"
            }
        }
    }
} 