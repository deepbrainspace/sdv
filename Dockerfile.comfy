FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    git \
    ffmpeg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git .

# Install Python dependencies
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
RUN pip3 install -r requirements.txt
RUN pip3 install opencv-python pillow transformers diffusers accelerate xformers
RUN pip3 install einops mediapy decord av

# Install additional dependencies for video processing
RUN pip3 install \
    pytorch_lightning \
    omegaconf \
    einops \
    matplotlib \
    scikit-image \
    scipy \
    pandas \
    kornia \
    "open-clip-torch>=2.0.0" \
    "gradio>=3.32.0" \
    timm

# Install additional nodes
WORKDIR /app/custom_nodes

# Core video generation nodes
RUN git clone https://github.com/Kosinkadink/ComfyUI-AnimateDiff-Evolved.git ComfyUI-AnimateDiff
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git
RUN git clone https://github.com/Fannovel16/ComfyUI-Frame-Interpolation.git
RUN git clone https://github.com/Stability-AI/stability-ComfyUI-nodes.git stability-nodes

# Control and enhancement nodes
RUN git clone https://github.com/Fannovel16/comfyui_controlnet_aux.git
RUN git clone https://github.com/Kosinkadink/ComfyUI-Advanced-ControlNet.git
RUN git clone https://github.com/cubiq/ComfyUI_IPAdapter_plus.git

# Audio and scheduling
RUN git clone https://github.com/a1lazydog/ComfyUI-AudioScheduler.git
RUN git clone https://github.com/Fannovel16/ComfyUI-Video-Matting.git

# Utility and workflow nodes
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git
RUN git clone https://github.com/11cafe/comfyui-workspace-manager.git
RUN git clone https://github.com/rgthree/rgthree-comfy.git
RUN git clone https://github.com/cubiq/ComfyUI_essentials.git
RUN git clone https://github.com/WASasquatch/was-node-suite-comfyui.git
RUN git clone https://github.com/ltdrdata/ComfyUI-Impact-Pack.git

# Install node dependencies
RUN find . -name "requirements.txt" -exec pip install -r {} \;

WORKDIR /app

# Setup model directories
RUN mkdir -p /models/{checkpoints,loras,embeddings,motion,controlnet,upscalers}

# Create config directory
RUN mkdir -p /app/configs

# Copy configs
COPY configs/comfy/* /app/configs/

EXPOSE 8188

CMD ["python3", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--output-directory", "/output"]
